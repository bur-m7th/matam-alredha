# ═══════════════════════════════════════════════════════════════════
#  Copy this file to .env before the first `docker compose up -d`.
#  Keep .env off any shared drive and out of version control.
#  (.gitignore and .dockerignore already exclude it.)
# ═══════════════════════════════════════════════════════════════════

# ── Secret dashboard addresses ────────────────────────────────────
# The two dashboards live at these URL segments and are linked from
# nowhere. Every other guess (/admin, /login, /dashboard) returns a
# plain 404, so an ordinary member has no way to tell they exist.
# Change these to your own values and keep them off any public page.
ADMIN_PATH=sijil-914109a6
ELECTIONS_PATH=majlis-71308567

# ── إدارة العضوية — membership dashboard ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Isa-Jidhafs-1491-$

# ── لجنة الانتخابات — elections dashboard ─────────────────────────
ELECTIONS_USERNAME=elections
ELECTIONS_PASSWORD=Manama-Jidhafs-1197-$


# ── Lockout recovery ──────────────────────────────────────────────
# These accounts are created on the FIRST boot only. Changing the
# passwords above later has no effect on a running installation.
#
# If a password is lost, set the matching variable below to true,
# put the new password in the field above, restart once, then set it
# back to false and restart again.
#
# ADMIN_PASSWORD_RESET=false
# ELECTIONS_PASSWORD_RESET=false


# ── Cloudflare tunnel ─────────────────────────────────────────────
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel.
# Copy the token from the install command it shows you.
# Leave blank if you are using your own reverse proxy instead.
CLOUDFLARE_TUNNEL_TOKEN=
